# ==============================================================================
# 呈尚策划 美工生图系统 PRO · 云端网关环境变量模板
# 路径：/opt/csgh-gateway/secrets/gateway.env
# 权限：chown csgh:csgh && chmod 600（已由安装脚本设置）
# ==============================================================================

# --- 监听地址（Caddy 反代用，外部不直连，保持默认即可）-----------------------
BACKEND_GATEWAY_HOST=127.0.0.1
BACKEND_GATEWAY_PORT=8787

# --- Supabase（必填）---------------------------------------------------------
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://你的项目.supabase.co
VITE_SUPABASE_ANON_KEY=你的_anon_public_key
# Secret keys 区域 sb_secret_xxx，仅服务端使用
SUPABASE_SERVICE_ROLE_KEY=你的_service_role_key

# --- 生图线路 API Key（按实际启用的线路填写）--------------------------------
# 线路 2（Zikl；同一 API Key 用于生图和后台余额读取）
IMAGE_2_LINE2_API_KEY=
# 图片墙专用（可选）
NEW_PICTURE_WALL_IMAGE2_API_KEY=
# 线路 3（vectorengine）
VECTORENGINE_IMAGE_2_API_KEY=
# 线路 4（pockgo）
POCKGO_IMAGE_2_API_KEY=
IMAGE_2_LINE4_API_KEY=
# 线路 5（APIMart）
APIMART_IMAGE_2_API_KEY=
# 线路 6（manxiaobai；同一 API Key 用于生图和后台余额读取；网关内置 3 次自动重试）
MANXIAOBAI_IMAGE_2_API_KEY=
# 线路 7（novaeworld OpenAI 兼容 gpt-image-2；同一 API Key 用于生图和后台余额读取；并发 = 6）
NOVA_IMAGE_2_API_KEY=

# --- 阿里云 OSS（必填）-------------------------------------------------------
# 推荐使用 RAM 子账号，仅授予 oss:PutObject + oss:GetObject 到指定 bucket
ALI_OSS_REGION=oss-cn-hangzhou
ALI_OSS_ACCESS_KEY_ID=
ALI_OSS_ACCESS_KEY_SECRET=
ALI_OSS_BUCKET=

# --- 生成图 OSS 归档限流（可选，默认 6）-------------------------------------
# 生成成功后的图片压缩和 generated/ 目录上传在网关执行；
# 6 大致匹配生图全局并发 28 在归档侧的吞吐，避免成为生图链路新瓶颈。
GATEWAY_OSS_ARCHIVE_LIMIT=6

# --- 生图并发限流（可选）-----------------------------------------------------
GATEWAY_GENERATION_GLOBAL_LIMIT=28
GATEWAY_GENERATION_USER_LIMIT=5
GATEWAY_GENERATION_LINE2_LIMIT=6
GATEWAY_GENERATION_LINE3_LIMIT=6
GATEWAY_GENERATION_LINE7_LIMIT=6

# --- 视频店招：抖音云端解析（可选）-----------------------------------------
# 网关只用 yt-dlp 解析并返回可下载视频地址，不在云端下载/保存视频。
# cookie 文件内容不要写进本文档；真实文件放 secrets 目录并限制权限。
DOUYIN_COOKIE_PATH=/opt/csgh-gateway/secrets/抖音cookie.txt
# 如系统 PATH 已安装 yt-dlp，可留空；否则指向可执行文件。
DOUYIN_YTDLP_PATH=
# Linux 上推荐固定到 Python 3.11+ 执行 yt-dlp，避免系统 python3 指向 3.10 时产生弃用警告。
DOUYIN_YTDLP_PYTHON=/usr/bin/python3.11

# --- 品牌故事文案接口（仅启用 thread1 / 向量引擎）---------------------------
# 图片生成仍走上述 image-2 线路，无需额外密钥
BRAND_STORY_THREAD1_BASE_URL=https://api.zhongzhuan.vip
BRAND_STORY_THREAD1_TEXT_API_KEY=
